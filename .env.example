# Sistema MEGAHNET - Variables de entorno
# Copiar a .env y llenar con valores reales (nunca subir .env al repo)

# ============== APLICACION ==============
BASE_URL=http://localhost/megahnet/
APP_TITLE=MEGAHNET
ENVIROMENT=0
# 0 = local, 1 = produccion

# ============== BASE DE DATOS ==============
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema

# ============== EMPRESA / SRI ==============
CIUDAD=QUEVEDO
PROVINCIA=LOS RIOS
CANTON=QUEVEDO
PARROQUIA=GUAYACAN

# ============== SMTP ==============
USER_SMTP=
CLAVE_SMTP=
HOST_SMTP=smtp.gmail.com
PUERTO_SMTP=465
SECURE_SMTP=1
CORREO_ALERTAS=

# ============== IMPRESION ==============
NOMBRE_IMPRESORA=POS-58-Series

# ============== SOPORTE ==============
CONTACTO=0000000000

# ============== CIFRADO ==============
CRYPT_KEY=cambiame-por-una-llave-aleatoria-de-32-chars

# ============== MIKROTIK (opcional) ==============
MIKROTIK_IP=192.168.88.1:9090
MIKROTIK_USER=admin
MIKROTIK_PASS=
MIKROTIK_PORT=8728

# ============== BACKUPS ==============
RUTARESPALDOBD=/var/backups/megahnet

# ============== WHATSAPP API ==============
# (Se configura desde la UI: /notificaciones -> tab WhatsApp)
