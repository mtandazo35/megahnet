# Sistema MEGAHNET - Variables de entorno
# Copiar a .env y llenar con valores reales (nunca subir .env al repo)

# ============== APLICACION ==============
# BASE_URL es opcional: por defecto se autodetecta del request (scheme + host).
# Solo definir si quieres forzar una URL fija (ej. para cron/CLI sin request HTTP)
# o si la app vive en un subdir y la auto-deteccion falla.
# BASE_URL=https://sistema.tudominio.com/
APP_TITLE=MEGAHNET
ENVIROMENT=0
# 0 = local, 1 = produccion

# ============== BASE DE DATOS ==============
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema

# ============== EMPRESA / SRI ==============
CIUDAD=QUEVEDO
PROVINCIA=LOS RIOS
CANTON=QUEVEDO
PARROQUIA=GUAYACAN

# ============== SMTP ==============
USER_SMTP=
CLAVE_SMTP=
HOST_SMTP=smtp.gmail.com
PUERTO_SMTP=465
SECURE_SMTP=1
CORREO_ALERTAS=

# ============== IMPRESION ==============
NOMBRE_IMPRESORA=POS-58-Series

# ============== SOPORTE ==============
CONTACTO=0000000000

# ============== CIFRADO ==============
CRYPT_KEY=cambiame-por-una-llave-aleatoria-de-32-chars

# ============== MIKROTIK (opcional) ==============
MIKROTIK_IP=192.168.88.1:9090
MIKROTIK_USER=admin
MIKROTIK_PASS=
MIKROTIK_PORT=8728

# ============== BACKUPS ==============
RUTARESPALDOBD=/var/backups/megahnet

# ============== WHATSAPP API ==============
# (Se configura desde la UI: /notificaciones -> tab WhatsApp)

# --- Snapshot Proxmox antes de actualizar (opcional) ---------------------
# Si se definen, el actualizador crea un snapshot de la VM antes de aplicar
# cambios. Es un extra: el respaldo de BD + codigo se hace siempre.
# El token necesita permiso VM.Snapshot sobre la VM.
#PVE_API_URL=https://192.0.2.10:8006
#PVE_TOKEN_ID=root@pam!megahnet-update
#PVE_TOKEN_SECRET=
#PVE_NODE=pve
#PVE_VMID=111

# --- Deploy key compartida para actualizar desde el panel (opcional) -----
# Esto NO es una variable de .env: es una variable de entorno que se pasa a
# install.sh para reutilizar UNA sola deploy key de solo lectura en toda la
# flota, en vez de generar (y registrar en GitHub) una por servidor:
#   sudo DEPLOY_KEY_FILE=/root/id_ed25519_megahnet bash install.sh
