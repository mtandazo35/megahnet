# Copiar a .env y rellenar (deploy.sh lo genera con valores aleatorios si no existe)

# ==== aplicacion ====
PORT=3005
STAGE=prod

# ==== postgres (interno al docker-compose) ====
POSTGRES_USER=whatsapp
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=whatsapp
# true = TypeORM crea tablas automaticamente al arrancar (necesario en primer boot)
DB_SYNC=true

# ==== seguridad ====
# Cualquier string >= 32 chars aleatorios. Usar:
#   openssl rand -hex 32
JWT_SECRET=cambiame-32chars-aleatorios

# ==== websocket opcional (lo deja vacio si no se usa) ====
HOST_WEBSOCKET=
